# data lives in nflverse releases, not in git — rebuild with:
#   python scripts/refresh_data.py --bootstrap
# EXCEPT the two hand-curated files, which exist nowhere else.
data/*
!data/stadiums.json
!data/coaches_meta.json
*.duckdb
*.duckdb.wal
logs/

# nightly-job outputs — regenerated by `nfl audit` and /health-check, so
# tracking them just churns the tree (model_report.md stays: it documents
# the paused model rather than last night's run)
docs/health_report.md
docs/data_audit.md

# local config & secrets (none required, but just in case)
.env
.streamlit/secrets.toml

# frontend build artifacts
web/ui/node_modules/
web/ui/dist/
web/ui/test-results/
web/ui/shots/
web/ui/playwright-report/

# claude code local-only config
.claude/settings.local.json
CLAUDE.local.md

# python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# OS noise
Thumbs.db
.DS_Store
